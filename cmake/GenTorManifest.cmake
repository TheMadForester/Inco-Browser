# Bake SHA-256 hashes of the bundled Tor into the binary.
# Usage: cmake -DTOR_DIR=<dir> -DOUT=<file.inc> -P GenTorManifest.cmake
# docs/ and debug/ are skipped (never loaded at runtime).
# The output file is only touched when its content changes.

set(body "// Generated by cmake/GenTorManifest.cmake. Do not edit.\n")
string(APPEND body "static const ManifestEntry kTorManifest[] = {\n")
set(info "")
set(count 0)

if(EXISTS "${TOR_DIR}/tor" AND NOT IS_DIRECTORY "${TOR_DIR}/tor")
  file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${TOR_DIR}" "${TOR_DIR}/*")
  list(SORT files)
  foreach(f IN LISTS files)
    if(f MATCHES "^(docs|debug)/")
      continue()
    endif()
    if(IS_SYMLINK "${TOR_DIR}/${f}")
      message(FATAL_ERROR "Tor bundle contains a symlink (${f}); refusing to bake hashes")
    endif()
    if(f MATCHES "[\"\\\\]")
      message(FATAL_ERROR "Unsupported file name in Tor bundle: ${f}")
    endif()
    file(SHA256 "${TOR_DIR}/${f}" h)
    string(APPEND body "    {\"${f}\", \"${h}\"},\n")
    math(EXPR count "${count} + 1")
  endforeach()
  if(EXISTS "${TOR_DIR}/.inco-bundle")
    file(READ "${TOR_DIR}/.inco-bundle" info)
    string(REPLACE "\\" "\\\\" info "${info}")
    string(REPLACE "\"" "\\\"" info "${info}")
    string(REPLACE "\n" "\\n" info "${info}")
  endif()
else()
  message(WARNING "No Tor bundle at ${TOR_DIR}; Onionize will refuse to start (run scripts/fetch-tor.sh and rebuild)")
endif()

string(APPEND body "    {nullptr, nullptr}\n};\n")
string(APPEND body "static const char kTorBundleInfo[] = \"${info}\";\n")

file(WRITE "${OUT}.tmp" "${body}")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
message(STATUS "Tor manifest: ${count} files hashed from ${TOR_DIR}")
